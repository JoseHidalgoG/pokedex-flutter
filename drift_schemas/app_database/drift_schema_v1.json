  "fixed_sql": [
    {
      "name": "pokemon",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon\" (\"id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"image_url\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pokemon_types",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon_types\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id) ON DELETE CASCADE, \"slot\" INTEGER NOT NULL, \"type_name\" TEXT NOT NULL, PRIMARY KEY (\"pokemon_id\", \"slot\"));"
        }
      ]
    },
    {
      "name": "sync_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_metadata\" (\"key\" TEXT NOT NULL, \"next_offset\" INTEGER NOT NULL DEFAULT 0, \"total_count\" INTEGER NULL, \"is_complete\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_complete\" IN (0, 1)), \"last_synced_at\" INTEGER NULL, \"last_error\" TEXT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "favorites",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favorites\" (\"pokemon_id\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"pokemon_id\"));"
        }
      ]
