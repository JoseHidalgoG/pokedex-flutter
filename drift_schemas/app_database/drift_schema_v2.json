        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"achievements\" (\"key\" TEXT NOT NULL, \"unlocked_at\" INTEGER NOT NULL, PRIMARY KEY (\"key\"));"
