      ]
    },
    {
      "name": "sync_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_metadata\" (\"key\" TEXT NOT NULL, \"next_offset\" INTEGER NOT NULL DEFAULT 0, \"total_count\" INTEGER NULL, \"is_complete\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_complete\" IN (0, 1)), \"last_synced_at\" INTEGER NULL, \"last_error\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'idle', \"attempt\" INTEGER NOT NULL DEFAULT 0, \"next_retry_at\" INTEGER NULL, \"last_verified_at\" INTEGER NULL, \"last_error_kind\" TEXT NULL, PRIMARY KEY (\"key\"));"
        }
