  "fixed_sql": [
    {
      "name": "pokemon",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon\" (\"id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"image_url\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"species_id\" INTEGER NULL, \"generation_id\" INTEGER NULL, \"is_default\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_default\" IN (0, 1)), \"height_dm\" INTEGER NULL, \"weight_hg\" INTEGER NULL, \"base_stat_total\" INTEGER NULL, \"remote_fingerprint\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pokemon_types",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon_types\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id) ON DELETE CASCADE, \"slot\" INTEGER NOT NULL, \"type_name\" TEXT NOT NULL, PRIMARY KEY (\"pokemon_id\", \"slot\"));"
        }
      ]
    },
    {
      "name": "pokemon_stats",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon_stats\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id) ON DELETE CASCADE, \"stat_name\" TEXT NOT NULL, \"base_stat\" INTEGER NOT NULL, PRIMARY KEY (\"pokemon_id\", \"stat_name\"));"
        }
      ]
    },
    {
      "name": "species",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"species\" (\"id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"generation_id\" INTEGER NULL, \"evolution_chain_id\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "species_egg_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"species_egg_groups\" (\"species_id\" INTEGER NOT NULL REFERENCES species (id) ON DELETE CASCADE, \"egg_group\" TEXT NOT NULL, PRIMARY KEY (\"species_id\", \"egg_group\"));"
        }
      ]
    },
    {
      "name": "abilities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"abilities\" (\"id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"name_es\" TEXT NULL, \"short_effect_es\" TEXT NULL, \"short_effect_en\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pokemon_abilities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon_abilities\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id) ON DELETE CASCADE, \"ability_id\" INTEGER NOT NULL, \"slot\" INTEGER NOT NULL, \"is_hidden\" INTEGER NOT NULL CHECK (\"is_hidden\" IN (0, 1)), PRIMARY KEY (\"pokemon_id\", \"slot\"));"
        }
      ]
    },
    {
      "name": "moves",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"moves\" (\"id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"name_es\" TEXT NULL, \"type_name\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pokemon_moves",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon_moves\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id) ON DELETE CASCADE, \"move_id\" INTEGER NOT NULL, \"version_group\" TEXT NOT NULL, \"learn_method\" TEXT NOT NULL, \"level\" INTEGER NOT NULL, PRIMARY KEY (\"pokemon_id\", \"move_id\", \"version_group\", \"learn_method\"));"
        }
      ]
    },
    {
      "name": "evolutions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"evolutions\" (\"id\" INTEGER NOT NULL, \"to_species_id\" INTEGER NOT NULL, \"from_species_id\" INTEGER NULL, \"chain_id\" INTEGER NOT NULL, \"trigger\" TEXT NULL, \"min_level\" INTEGER NULL, \"item\" TEXT NULL, \"min_happiness\" INTEGER NULL, \"time_of_day\" TEXT NULL, \"location\" TEXT NULL, \"known_move_type\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pokemon_games",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon_games\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id) ON DELETE CASCADE, \"version_name\" TEXT NOT NULL, PRIMARY KEY (\"pokemon_id\", \"version_name\"));"
        }
      ]
    },
    {
      "name": "type_efficacy",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"type_efficacy\" (\"attacking_type\" TEXT NOT NULL, \"defending_type\" TEXT NOT NULL, \"damage_factor\" INTEGER NOT NULL, PRIMARY KEY (\"attacking_type\", \"defending_type\"));"
        }
      ]
    },
    {
      "name": "favorites",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favorites\" (\"pokemon_id\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"pokemon_id\"));"
        }
      ]
    },
    {
      "name": "trivia_results",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trivia_results\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"score\" INTEGER NOT NULL, \"correct_answers\" INTEGER NOT NULL, \"total_questions\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"played_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "trivia_answers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trivia_answers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"result_id\" INTEGER NOT NULL REFERENCES trivia_results (id) ON DELETE CASCADE, \"pokemon_id\" INTEGER NOT NULL, \"correct\" INTEGER NOT NULL CHECK (\"correct\" IN (0, 1)), \"response_ms\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "achievements",
